# Скопируйте в .env и впишите ключ. Без ключа очеловечивание работает
# только локальными правилами (без ИИ).
LLM_API_KEY=
# Необязательно:
LLM_BASE_URL=https://api.intelligence.io.solutions/api/v1
# Модели через запятую - перебираются по порядку, если предыдущая недоступна
LLM_MODELS=Qwen/Qwen3-Next-80B-A3B-Instruct,deepseek-ai/DeepSeek-V4-Flash-0731
LLM_TIMEOUT=20 # В секундах